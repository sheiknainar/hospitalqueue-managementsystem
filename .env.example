# Supabase Configuration
# Replace these with your actual Supabase project credentials
# Find them in Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Google Gemini AI Configuration (Optional, app works with built-in triage engine if omitted)
# Get a free key at: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# Automated SMS Gateway Configuration (Optional - Fast2SMS for Indian Mobile Numbers)
# Sign up at https://www.fast2sms.com for Quick SMS API key
VITE_FAST2SMS_API_KEY=
VITE_SMS_SENDER_ID=BRHOSP
